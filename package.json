{
  "name": "permission-next-super-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:car:readiness": "node scripts/car-booking-readiness.mjs",
    "import:car": "node scripts/import-car-booking.mjs",
    "test:car:import:unit": "node --test scripts/car-booking-import-unit.test.mjs",
    "test:car:import": "node scripts/car-booking-test-db.mjs && node --test scripts/car-booking-import.test.mjs",
    "test:car:schema": "node scripts/car-booking-test-db.mjs && node --test scripts/car-booking-schema.test.mjs",
    "test:car:services": "node scripts/car-booking-test-db.mjs && node scripts/car-booking-service-test.mjs",
    "test:car:browser": "node scripts/car-booking-test-db.mjs && node scripts/car-booking-browser-fixture.mjs && node scripts/car-booking-browser-test.mjs",
    "check:css": "node scripts/check-css-quality.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e": "node scripts/render-ux-error-fixture.cjs",
    "test:ux:seed": "node scripts/ux-test-db.mjs init && node scripts/ux-test-db.mjs seed",
    "dev": "node scripts/run-with-nas.cjs dev",
    "build": "next build",
    "start": "node scripts/run-with-nas.cjs start",
    "test:documents": "node --test mods/permission-next/tests/document-mapping.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "auth:bootstrap": "node scripts/bootstrap-admin.mjs",
    "import:guarantees": "node scripts/import-guarantee-csv.mjs",
    "reconcile:guarantee-other": "node scripts/reconcile-guarantee-legacy-other.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.8",
    "postgres": "^3.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
