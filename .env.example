DATABASE_URL=
# Private folder or organization file share; only the application service account should access it.
GUARANTEE_STORAGE_DIR=D:\PermissionNextData\guarantee-evidence
GUARANTEE_LEGACY_DIR=D:\path\to\guarantee-source
MAXIWA_LEGACY_DIR=D:\path\to\maxiwa-kpi-source
MAXIWA_API_BASE=http://127.0.0.1:8788/api/
MAXIWA_DEV_EMP_ID=

# Permission Next documents (NAS). The bridge starts with npm run dev/start.
NAS_BUILDING_ROOT=P:\path\to\building-documents
PERMISSION_NAS_BRIDGE_URL=http://127.0.0.1:8766
# Required when the bridge runs as a separate service. The bundled launcher
# creates an ephemeral 256-bit secret automatically when this is empty.
PERMISSION_NAS_BRIDGE_SECRET=
# Set to 1 only when the bridge is managed by another process/service.
PERMISSION_NAS_BRIDGE_EXTERNAL=0

# Microsoft 365 / SharePoint readiness (server-only; never expose the secret).
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
SHAREPOINT_HOSTNAME=example.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/example
SHAREPOINT_DOCUMENT_LIBRARY=Shared Documents
SHAREPOINT_ROOT_FOLDER=Permission Next
# Optional stable IDs discovered after the first successful readiness check.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Authentication hardening. Leave TRUSTED_PROXY_COUNT at 0 unless the deployment
# has a known reverse-proxy chain whose forwarded headers are trusted.
TRUSTED_PROXY_COUNT=0
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_TIMEOUT_HOURS=12

# Home dashboard adapters. Each internal endpoint returns:
# { "items": [{ "id", "kind", "priority", "title", "description"?, "href"?, "dueAt"?, "statusLabel" }] }
DASHBOARD_WORK_SOURCE_URL=
DASHBOARD_BUILDINGS_SOURCE_URL=
DASHBOARD_GUARANTEES_SOURCE_URL=
DASHBOARD_INTEGRATION_SECRET=
