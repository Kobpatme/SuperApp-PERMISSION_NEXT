# Copy to .env for LOCAL Docker Compose. Values below are local placeholders,
# not IT infrastructure or production credentials. Never commit the filled file.
# For native npm dev use a separate .env.local with localhost URLs/host paths.
# [runtime] unless marked [build]. No NEXT_PUBLIC_* variables are used.

# App / container
# [runtime] Internal app listener; HOSTNAME is set to 0.0.0.0 by Docker.
PORT=3000
# [runtime] Local host binding; shared/production exposure is an IT decision.
APP_BIND_ADDRESS=127.0.0.1
# [runtime] Host-side local port; independent from PORT inside the container.
APP_HOST_PORT=3000
# [compose] Optional image tags; CI overrides these without secrets.
APP_IMAGE=superapp:local
TOOLS_IMAGE=superapp-tools:local
# NODE_ENV/NEXT_RUNTIME are managed by Next/Docker, not user configuration.
# NEXT_TELEMETRY_DISABLED=1 and HOSTNAME=0.0.0.0 are set in Dockerfile.

# Database / local fixture
# [compose] Existing CI/portable fixture major. TODO(IT): confirm TencentDB version.
POSTGRES_VERSION=16
# [compose] Local database name. Not a TencentDB name.
POSTGRES_DB=superapp_local
# [compose] Local operator needs helper-role privileges; never used by the app.
POSTGRES_USER=superapp_migrate
# [compose] Local-only placeholder; replace before any shared use.
POSTGRES_PASSWORD=replace-with-local-migration-password
# [runtime] Non-owner Core login, member ONLY of permission_core_runtime.
DATABASE_URL=postgresql://superapp_core:replace-with-local-core-password@db:5432/superapp_local
# [operator] Separate schema/bootstrap URL; never inject into the web container.
DATABASE_URL_MIGRATE=postgresql://superapp_migrate:replace-with-local-migration-password@db:5432/superapp_local
# [runtime] Separate constrained Car login; local name matches existing grants SQL.
CAR_BOOKING_DATABASE_URL=postgresql://permission_car_booking_runtime:replace-with-local-car-password@db:5432/superapp_local
# [runtime] Separate constrained Duct login, member ONLY of duct_rental_runtime.
DUCT_RENTAL_DATABASE_URL=postgresql://superapp_duct:replace-with-local-duct-password@db:5432/superapp_local
# [runtime/operator] disable|require|verify-full. TODO(IT): confirm production TLS.
DATABASE_SSL=disable
# [runtime/operator] Container path to read-only CA file; only with verify-full.
DATABASE_SSL_CA_PATH=

# Private storage (Compose mounts these at fixed internal paths)
# [runtime] Persist guarantee evidence outside public/.
GUARANTEE_STORAGE_DIR=/data/guarantees
# [runtime] Persist private Duct documents/signatures outside public/.
DUCT_RENTAL_STORAGE_DIR=/data/duct-rental

# Auth & sessions
# [runtime] 0 until IT confirms its trusted proxy chain.
TRUSTED_PROXY_COUNT=0
# [runtime] Inactive-session timeout, minutes.
AUTH_IDLE_TIMEOUT_MINUTES=30
# [runtime] Absolute session lifetime, hours.
AUTH_ABSOLUTE_TIMEOUT_HOURS=12
# [runtime] Preserve single-active-session behaviour.
AUTH_SINGLE_SESSION=true
# [runtime] Optional owner-approved Thai support contact.
SUPPORT_CONTACT_TEXT=

# Initial admin — one-time operator command only; no default credentials
# [bootstrap] Supply privately before running the bootstrap profile.
INITIAL_ADMIN_EMAIL=
# [bootstrap] Human-readable name, 2-180 characters.
INITIAL_ADMIN_DISPLAY_NAME=
# [bootstrap] 12-256 characters with letters/numbers/symbol; remove after use.
INITIAL_ADMIN_PASSWORD=

# Build identity — public metadata only, never pass secrets as build args
# [build; optional runtime override] Set from git rev-parse HEAD; CI supplies SHA.
APP_COMMIT_SHA=
# [build; optional runtime override] CI supplies source branch name.
APP_BRANCH=
# [build; optional runtime override] ISO date; empty generates current build time.
APP_BUILT_AT=
# [build/runtime fallback] Optional existing hosting-provider metadata.
VERCEL_GIT_COMMIT_SHA=
VERCEL_GIT_COMMIT_REF=
CF_PAGES_COMMIT_SHA=
CF_PAGES_BRANCH=
GITHUB_SHA=
GITHUB_HEAD_REF=
GITHUB_REF_NAME=

# Optional map / NAS bridge
# [runtime] Browser Longdo key; register the deployment referrer with Longdo.
LONGDO_MAP_API_KEY=
# [bridge runtime] Container mount; native development uses an absolute host path.
NAS_BUILDING_ROOT=/data/nas
# [runtime] Internal local bridge; TODO(IT): NAS mount/external bridge address.
PERMISSION_NAS_BRIDGE_URL=http://nas:8766
# [runtime/bridge] Shared placeholder, >=32 chars; inject a random secret in real use.
PERMISSION_NAS_BRIDGE_SECRET=replace-with-random-bridge-secret-before-shared-use
# [native launcher only] 1 when the bridge is managed separately.
PERMISSION_NAS_BRIDGE_EXTERNAL=1
# [bridge only] Bind address; bridge service overrides this to 0.0.0.0.
DEV_HOST=127.0.0.1

# Optional Microsoft 365 / SharePoint (server runtime)
# [runtime] Tenant identifier.
M365_TENANT_ID=
# [runtime] App registration identifier.
M365_CLIENT_ID=
# [runtime secret] App credential; never a build arg.
M365_CLIENT_SECRET=
# [runtime] TODO(IT): SharePoint hostname/site, if this adapter is used.
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
# [runtime] Optional library/folder names and previously discovered stable IDs.
SHAREPOINT_DOCUMENT_LIBRARY=Shared Documents
SHAREPOINT_ROOT_FOLDER=Permission Next
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Optional Car / Google Sheets integration (server runtime)
# [runtime] false pauses new bookings using the existing maintenance switch.
CAR_BOOKING_ACCEPT_NEW_BOOKINGS=true
# [runtime] Enable only after IT provisions/reviews the Google integration.
CAR_BOOKING_OSP_SYNC_ENABLED=false
# [runtime] Google spreadsheet identifier and worksheet title.
CAR_BOOKING_OSP_SPREADSHEET_ID=
CAR_BOOKING_OSP_SHEET_TITLE=BookingsOSP
# [runtime secrets] Service-account identity/key; preserve escaped newlines.
CAR_BOOKING_GOOGLE_CLIENT_EMAIL=
CAR_BOOKING_GOOGLE_PRIVATE_KEY=
# [runtime] Approved worker identity and bearer secret.
CAR_BOOKING_OSP_WORKER_USER_ID=
CAR_BOOKING_OSP_WORKER_SECRET=
# [operator] Separate reviewed import/readiness connections; not web config.
CAR_BOOKING_IMPORT_DATABASE_URL=
CAR_BOOKING_READINESS_DATABASE_URL=

# Legacy/dev-only adapters; not passed to production containers
# [dev] Absolute source checkout paths when explicitly working on legacy parity.
GUARANTEE_LEGACY_DIR=
MAXIWA_LEGACY_DIR=
# [dev] Optional legacy API endpoint and fixture employee identity.
MAXIWA_API_BASE=
MAXIWA_DEV_EMP_ID=
# [unused example adapters] Retained for compatibility; not current requirements.
DASHBOARD_WORK_SOURCE_URL=
DASHBOARD_BUILDINGS_SOURCE_URL=
DASHBOARD_GUARANTEES_SOURCE_URL=
DASHBOARD_INTEGRATION_SECRET=

# Optional test/tool variables — never inject into production
# [test] Explicit opt-in flags; blank disables fixture-only modes.
BUILDING_DELETE_INTEGRATION=
CAR_BOOKING_LOCAL_UAT_TEST=
CAR_BOOKING_SERVICE_INTEGRATION=
DUCT_RENTAL_INTEGRATION=
DUCT_RENTAL_PDF_QA=
DUCT_RENTAL_FIXTURE_METRICS=
PARITY_INTEGRATION=
PARITY_QUERY_METRICS=
# [test] Existing scripts enforce their own loopback/database-name guards.
CAR_BOOKING_TEST_DATABASE_URL=
DUCT_RENTAL_TEST_DATABASE_URL=
PARITY_TEST_DATABASE_URL=
UX_TEST_DATABASE_URL=
# [test] Optional local binary/Python paths and evidence directory.
CAR_BOOKING_TEST_PG_BIN=
DUCT_RENTAL_TEST_PYTHON=
CAR_BOOKING_EVIDENCE_DIR=
# [test] Existing test rendering can control timezone.
TZ=
# [test internal] These are supplied only by the disposable acceptance runner.
# COMPOSE_LOCAL_DATABASE=1
# DEPLOY_TEST_BASE_URL=http://app:3000
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
